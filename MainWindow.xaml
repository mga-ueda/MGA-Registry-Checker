<Window x:Class="MGA_RegistryChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MGA_RegistryChecker"
        Title="{x:Static local:UiText.AppName}"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="520" Width="860"
        MinHeight="360" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        Loaded="Window_OnLoaded"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="10" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static local:UiText.AppName}" FontSize="22" FontWeight="SemiBold"/>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Static local:UiText.LabelKey}" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{StaticResource FgMutedBrush}"/>
                <TextBox x:Name="PathBox" Grid.Column="1" Height="28" Padding="6,2"
                         VerticalContentAlignment="Center"
                         TextChanged="Input_OnChanged"
                         ToolTip="{x:Static local:UiText.TooltipKeyPath}"/>

                <TextBlock Grid.Column="2" Text="{x:Static local:UiText.LabelValue}" VerticalAlignment="Center" Margin="10,0,10,0"
                           Foreground="{StaticResource FgMutedBrush}"/>
                <TextBox x:Name="ValueBox" Grid.Column="3" Height="28" Padding="6,2"
                         VerticalContentAlignment="Center"
                         TextChanged="Input_OnChanged"
                         ToolTip="{x:Static local:UiText.TooltipValueName}"/>
                <Button x:Name="AddButton" Grid.Column="4" Content="{x:Static local:UiText.ButtonAddWatch}"
                        Width="120" Height="28" Margin="10,0,0,0" Padding="8,2"
                        Style="{StaticResource PrimaryButton}" Click="Add_Click"
                        ToolTip="{x:Static local:UiText.TooltipAddWatch}"/>

                <TextBlock x:Name="ValidationMessage" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                           Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource FgMutedBrush}"
                           Text="{x:Static local:UiText.ValidationHintIdle}"
                           ToolTip="{x:Static local:UiText.TooltipValidation}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="6" Margin="0,10,0,0" Padding="10"
                UseLayoutRounding="True"
                MouseLeftButtonDown="WatchedEmpty_OnMouseLeftButtonDown">
            <Grid UseLayoutRounding="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="LocationList"
                         SelectionChanged="LocationList_OnSelectionChanged"
                         PreviewMouseLeftButtonDown="LocationList_OnPreviewMouseLeftButtonDown"
                         UseLayoutRounding="True"
                         SnapsToDevicePixels="True"
                         ToolTip="{x:Static local:UiText.TooltipWatchList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel ToolTip="{Binding DisplayPath}">
                                <TextBlock Text="{Binding DisplayPath}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Foreground="{StaticResource FgMutedBrush}" FontSize="12" Margin="0,2,0,0">
                                    <Run Text="{Binding ModeLabel, Mode=OneWay}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding KeyCount, Mode=OneWay}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding CapturedAtText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyHint"
                           Text="{x:Static local:UiText.EmptyWatchList}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource FgMutedBrush}"
                           IsHitTestVisible="False"/>

                <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="False"
                           Background="Transparent"
                           MouseLeftButtonDown="WatchedEmpty_OnMouseLeftButtonDown">
                    <Button x:Name="SimulateDiffButton" DockPanel.Dock="Left"
                            Content="{x:Static local:UiText.ButtonSimulateDiff}" Width="130" Height="28"
                            Visibility="Collapsed"
                            Style="{StaticResource SecondaryButton}"
                            Click="SimulateDiff_Click"
                            ToolTip="{x:Static local:UiText.TooltipSimulateDiff}"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="CheckNowButton" Content="{x:Static local:UiText.ButtonCheckNow}" Width="110" Height="28" Margin="0,0,10,0"
                                IsEnabled="False"
                                Style="{StaticResource CheckButton}" Click="CheckNow_Click"
                                ToolTip="{x:Static local:UiText.TooltipCheckNow}"/>
                        <Button x:Name="RecaptureButton" Content="{x:Static local:UiText.ButtonRecapture}" Width="110" Height="28" Margin="0,0,10,0"
                                IsEnabled="False"
                                Style="{StaticResource RecaptureButton}" Click="Recapture_Click"
                                ToolTip="{x:Static local:UiText.TooltipRecapture}"/>
                        <Button x:Name="RemoveButton" Content="{x:Static local:UiText.ButtonRemove}" Width="80" Height="28"
                                IsEnabled="False"
                                Style="{StaticResource DangerButton}" Click="Remove_Click"
                                ToolTip="{x:Static local:UiText.TooltipRemove}"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0"
                   Foreground="{StaticResource FgMutedBrush}" Text="{x:Static local:UiText.Ready}"
                   ToolTip="{x:Static local:UiText.TooltipStatus}"/>
    </Grid>
</Window>