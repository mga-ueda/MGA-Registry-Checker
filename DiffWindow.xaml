<Window x:Class="MGA_RegistryChecker.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MGA_RegistryChecker"
        Title="{x:Static local:UiText.TitleDiff}"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="560" Width="980"
        MinHeight="400" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="SubText" Grid.Row="1" Margin="0,10,0,0"
                   Foreground="{StaticResource FgMutedBrush}" TextWrapping="Wrap"/>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="4" Margin="0,10,0,0" Padding="0">
            <DataGrid x:Name="ChangeGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      AlternationCount="2"
                      SelectionUnit="FullRow"
                      SelectionMode="Single"
                      RowHeaderWidth="0"
                      BorderThickness="0"
                      Background="Transparent"
                      Foreground="{StaticResource FgBrush}"
                      FontSize="12"
                      FontFamily="Consolas"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      UseLayoutRounding="True"
                      SnapsToDevicePixels="True"
                      Loaded="ChangeGrid_OnLoaded"
                      PreviewMouseLeftButtonDown="ChangeGrid_OnPreviewMouseLeftButtonDown"
                      PreviewMouseMove="ChangeGrid_OnPreviewMouseMove"
                      PreviewMouseLeftButtonUp="ChangeGrid_OnPreviewMouseLeftButtonUp"
                      LostMouseCapture="ChangeGrid_OnLostMouseCapture">
                <DataGrid.Resources>
                    <Style x:Key="CenterTextCell" TargetType="DataGridCell"
                           BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <Style x:Key="CenterCheckCell" TargetType="DataGridCell"
                           BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="4,2"/>
                    </Style>
                    <Style x:Key="AcceptCheckBox" TargetType="CheckBox">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border x:Name="Bd" Width="16" Height="16" CornerRadius="2"
                                            BorderThickness="1" BorderBrush="{StaticResource AccentBrush}"
                                            Background="{StaticResource BtnPrimaryFillBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            SnapsToDevicePixels="True">
                                        <Viewbox Width="10" Height="10"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path x:Name="Mark" Visibility="Collapsed"
                                                  Stroke="White" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Data="M1,5.5 L4.2,8.7 L9.5,1.5"/>
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="RevertCheckBox" TargetType="CheckBox">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border x:Name="Bd" Width="16" Height="16" CornerRadius="2"
                                            BorderThickness="1" BorderBrush="{StaticResource DangerBrush}"
                                            Background="{StaticResource BtnDangerFillBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            SnapsToDevicePixels="True">
                                        <Viewbox Width="10" Height="10"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path x:Name="Mark" Visibility="Collapsed"
                                                  Stroke="White" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Data="M1,5.5 L4.2,8.7 L9.5,1.5"/>
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerBrush}"/>
                                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DangerHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="TypeColumn" Header="{x:Static local:UiText.ColumnType}" Width="Auto" MinWidth="64"
                                            CellStyle="{StaticResource CenterTextCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding KindLabel}" Foreground="{Binding KindBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="KeyColumn" Header="{x:Static local:UiText.ColumnKey}" Binding="{Binding KeyPath}"
                                        Width="*" IsReadOnly="True" MinWidth="120"/>
                    <DataGridTextColumn x:Name="ValueColumn" Header="{x:Static local:UiText.ColumnValue}" Binding="{Binding ValueName}"
                                        Width="Auto" IsReadOnly="True" MinWidth="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="None"/>
                                <Setter Property="Padding" Value="2,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="ToolTip" Value="{Binding ValueName}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="OldColumn" Header="{x:Static local:UiText.ColumnOld}" Binding="{Binding OldText}"
                                        Width="Auto" IsReadOnly="True" MinWidth="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="None"/>
                                <Setter Property="Padding" Value="2,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="ToolTip" Value="{Binding OldText}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="NewColumn" Header="{x:Static local:UiText.ColumnNew}" Binding="{Binding NewText}"
                                        Width="Auto" IsReadOnly="True" MinWidth="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="None"/>
                                <Setter Property="Padding" Value="2,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="ToolTip" Value="{Binding NewText}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn x:Name="AcceptColumn" Width="Auto" MinWidth="88"
                                            CellStyle="{StaticResource CenterCheckCell}">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        ToolTip="{x:Static local:UiText.TooltipAcceptHeader}">
                                <CheckBox x:Name="AcceptHeaderCheck"
                                          Style="{StaticResource AcceptCheckBox}"
                                          ToolTip="{x:Static local:UiText.TooltipAcceptHeaderCheck}"
                                          Checked="AcceptHeader_Changed"
                                          Unchecked="AcceptHeader_Changed"/>
                                <TextBlock Text="{x:Static local:UiText.ColumnAccept}" VerticalAlignment="Center" Margin="4,0,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource AcceptCheckBox}" Tag="Accept"
                                          IsChecked="{Binding IsAccept, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="{x:Static local:UiText.TooltipAcceptRow}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="RevertColumn" Width="Auto" MinWidth="88"
                                            CellStyle="{StaticResource CenterCheckCell}">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        ToolTip="{x:Static local:UiText.TooltipRevertHeader}">
                                <CheckBox x:Name="RevertHeaderCheck"
                                          Style="{StaticResource RevertCheckBox}"
                                          ToolTip="{x:Static local:UiText.TooltipRevertHeaderCheck}"
                                          Checked="RevertHeader_Changed"
                                          Unchecked="RevertHeader_Changed"/>
                                <TextBlock Text="{x:Static local:UiText.ColumnRevert}" VerticalAlignment="Center" Margin="4,0,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource DangerBrush}"/>
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource RevertCheckBox}" Tag="Revert"
                                          IsChecked="{Binding IsRevert, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="{x:Static local:UiText.TooltipRevertRow}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{x:Static local:UiText.ButtonCancel}" Width="110" Height="28" Margin="0,0,10,0"
                        Style="{StaticResource GrayButton}" Click="Cancel_Click"
                        ToolTip="{x:Static local:UiText.TooltipCancel}"/>
                <Button x:Name="ApplyButton" Content="{x:Static local:UiText.ButtonApply}" Width="110" Height="28"
                        Style="{StaticResource DangerButton}" Click="Apply_Click"
                        IsEnabled="False"
                        ToolTip="{x:Static local:UiText.TooltipApply}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>